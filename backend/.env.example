# ITCT CRM backend (Node.js) — copy to .env and fill in. Never commit real secrets.
PORT=8000

# PostgreSQL (main database)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/itct_crm

# Create all tables automatically on boot (safe: uses IF NOT EXISTS)
AUTO_MIGRATE=true

# Auth
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Identity Services OAuth 2.0 Web Client ID.
# Must match VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=

# CORS — comma separated origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ollama (optional local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
