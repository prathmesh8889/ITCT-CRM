# ITCT CRM backend (Node.js) — copy to .env and fill in. Never commit real secrets.
NODE_ENV=development
PORT=8000

# PostgreSQL (main database)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/itct_crm

# Create all tables automatically on boot (safe: uses IF NOT EXISTS)
AUTO_MIGRATE=true

# Auth — production requires a unique random secret with 48+ characters.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Only needed to create the first user on an empty database with npm run seed.
# Never commit real values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# CORS — comma separated trusted frontend origins. Production should use HTTPS only.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Ollama (optional local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Google Calendar meeting booking (optional)
# 1) Create a Google Cloud service account and enable Google Calendar API.
# 2) Share the target Google Calendar with the service-account email with permission to make changes.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep this quoted on hosting platforms; escaped \\n is supported.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_TIMEZONE=Asia/Kolkata
GOOGLE_CALENDAR_UTC_OFFSET=+05:30
