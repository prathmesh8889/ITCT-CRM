# Frontend environment (copy to .env)

# Node.js/Express backend base URL (production mode — the default)
VITE_API_URL=http://localhost:8000/api

# DEMO MODE — dev-only, browser-embedded sample workspace, clearly labelled in the UI.
# Default is "false": Node.js/Express + PostgreSQL is the only data source and the app will
# show "CRM server is unavailable" instead of silently writing to localStorage.
VITE_DEMO_MODE=false
